# ============================================================
#  BANCA NEN — Backend
#  Copia este archivo como backend/.env y rellena tus valores
# ============================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---------- Base de datos ----------
# Fuera de Docker: 127.0.0.1 y el puerto 5433 que publica docker-compose.
# Dentro de Docker estas variables las pone docker-compose.yml (DB_HOST=postgres).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=banca_nen
DB_PASSWORD=banca_nen_secret
DB_NAME=banca_nen

# ---------- JWT ----------
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
#  CORREO ELECTRONICO  (esto es lo que hace que lleguen los codigos)
#  EMAIL_PROVIDER = resend | smtp | console
#  Si lo dejas vacio se autodetecta.
# ============================================================
EMAIL_PROVIDER=resend

# ---------- OPCION A (RECOMENDADA): Resend ----------
# 1. Crea una cuenta gratis en https://resend.com  (3.000 correos/mes)
# 2. API Keys -> Create API Key -> copia la clave (empieza por re_)
# 3. Para pruebas puedes usar el remitente onboarding@resend.dev
#    (solo llega a TU propio correo registrado en Resend).
#    Para enviar a cualquiera, verifica tu dominio en Resend -> Domains.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=BANCA NEN <onboarding@resend.dev>

# ---------- OPCION B: SMTP (Gmail) ----------
# Pon EMAIL_PROVIDER=smtp y comenta RESEND_API_KEY.
# IMPORTANTE: con Gmail necesitas una CONTRASENA DE APLICACION de 16 caracteres:
#   1. Activa la verificacion en 2 pasos en tu cuenta Google
#   2. https://myaccount.google.com/apppasswords -> genera una
#   3. Pegala en SMTP_PASS (sin espacios). NO uses tu contrasena normal.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM=BANCA NEN <tucorreo@gmail.com>

# ---------- OPCION C: sin correo (solo consola) ----------
# EMAIL_PROVIDER=console
# Los codigos se imprimen en la terminal del backend.

# ============================================================
#  SMS (opcional). Si no lo configuras, la verificacion por
#  telefono se omite automaticamente y solo se pide el email.
# ============================================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+15551234567

# ---------- Redis (opcional) ----------
REDIS_URL=redis://localhost:6379
