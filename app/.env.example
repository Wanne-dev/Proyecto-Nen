# Opcional para Docker Compose local. Los valores sensibles quedan vacíos.
# Copiar a .env solo si necesitas personalizar puertos o servicios.
# Al actualizar, conserva el .env anterior y los volúmenes del mismo proyecto.
POSTGRES_HOST_PORT=5433
POSTGRES_PASSWORD=
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
# Opcional en la instalación local (se genera y persiste); obligatoria y distinta del JWT en staging.
ENCRYPTION_KEY=
EMAIL_PROVIDER=console
MARKET_OFFLINE=false

# Asistente IA: la clave solo la lee el backend. Ponerla en perfil.env para INICIAR.bat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcionales para una integración autorizada; no poner claves reales en Git.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
