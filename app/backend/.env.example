# Copiar a backend/.env solo para ejecutar la API fuera de Docker.
NODE_ENV=development
APP_MODE=virtual
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=banca_nen
# Usa la contraseña de tu PostgreSQL local; para el contenedor local: local-demo-only.
DB_PASSWORD=
DB_NAME=banca_nen
DB_SSL=false
# Para usar DATABASE_URL deja DB_HOST vacío y completa la URL local.
DATABASE_URL=
# Vacío en desarrollo = secreto aleatorio por proceso. Producción exige uno propio.
JWT_SECRET=
# Clave de cifrado independiente: 64 dígitos hexadecimales. Vacía en el arranque local usa un archivo local privado.
ENCRYPTION_KEY=
# Opcional: otro archivo privado para la clave generada en desarrollo.
AUTH_KEY_FILE=
EMAIL_PROVIDER=console
MARKET_OFFLINE=false

# Asistente IA: clave privada del proveedor, nunca enviada al navegador.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Integraciones opcionales; no rellenar con credenciales reales en archivos versionados.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
