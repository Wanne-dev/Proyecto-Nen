{
  "name": "banca-nen-backend",
  "version": "1.0.0",
  "description": "BANCA NEN - Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@types/nodemailer": "8.0.1",
    "bcrypt": "5.1.1",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-async-errors": "3.1.1",
    "helmet": "7.2.0",
    "ioredis": "5.11.1",
    "joi": "17.13.6",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.11.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "rate-limiter-flexible": "4.0.1",
    "reflect-metadata": "0.1.14",
    "resend": "6.21.0",
    "speakeasy": "2.0.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "twilio": "6.1.0",
    "typeorm": "0.3.31",
    "uuid": "9.0.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/speakeasy": "2.0.10",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@types/uuid": "9.0.8",
    "supertest": "7.2.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
